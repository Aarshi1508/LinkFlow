# Used by docker-compose.yml to configure all three services consistently.
# Copy this to .env before running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=linkflow_user
POSTGRES_PASSWORD=linkflow_pass
POSTGRES_DB=linkflow_db

# --- Backend ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# Must be reachable from the user's browser, so use localhost, not the
# Docker service name "backend" (that only resolves inside the Docker network).
VITE_API_URL=http://localhost:8000
