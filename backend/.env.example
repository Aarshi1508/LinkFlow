# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://linkflow_user:linkflow_pass@db:5432/linkflow_db

# --- JWT / Auth ---
# Generate a strong secret in production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
APP_NAME=LinkFlow API
ENVIRONMENT=development

# Base URL used to build the full short link shown to users
# e.g. http://localhost:8000
BASE_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
